[Unit]
Description=ElanQuant durable on-demand worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/yilangliu/a_share_research/elanquant/source
Environment=PYTHONUNBUFFERED=1
Environment=ELANQUANT_CONFIG=/data/yilangliu/a_share_research/elanquant/source/configs/app.yaml
Environment=ELANQUANT_DB_PATH=/data/yilangliu/a_share_research/elanquant/artifacts/elanquant.sqlite3
Environment=ELANQUANT_ARTIFACT_ROOT=/data/yilangliu/a_share_research/elanquant/artifacts/runs
Environment=ELANQUANT_FRONTEND_DIST=/data/yilangliu/a_share_research/elanquant/source/frontend/dist
Environment=ELANQUANT_PIPELINE_MODE=real
Environment=ELANQUANT_RESEARCH_PYTHON=/data/yilangliu/a_share_research/seven_model_research/.venv/bin/python
Environment=ELANQUANT_RESEARCH_DEPS=/data/yilangliu/a_share_research/elanquant/research-deps
Environment=ELANQUANT_PROXY_CLIENT=/data/yilangliu/a_share_research/scripts/tushare_proxy_client.py
Environment=ELANQUANT_UPSTREAM_ROOT=/data/yilangliu/a_share_research/elanquant/upstream/Kronos
Environment=ELANQUANT_MATRIX_RECEIPT=/data/yilangliu/a_share_research/elanquant/releases/current/training-matrix.json
Environment=ELANQUANT_EVALUATION_RECEIPT=/data/yilangliu/a_share_research/elanquant/releases/current/formal-evaluation.json
Environment=ELANQUANT_RESEARCH_CATALOG=/data/yilangliu/a_share_research/elanquant/releases/research-catalog.json
Environment=ELANQUANT_HISTORICAL_BACKTEST_CATALOG=/data/yilangliu/a_share_research/elanquant/releases/historical-backtest-catalog.json
ExecStart=/data/yilangliu/a_share_research/elanquant/app-venv/bin/elanquant-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
